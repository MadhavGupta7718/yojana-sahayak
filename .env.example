# Database
POSTGRES_USER=yojana
POSTGRES_PASSWORD=yojana_secure_change_me
POSTGRES_DB=yojana_sahayak
DATABASE_URL=postgresql+psycopg2://yojana:yojana_secure_change_me@db:5432/yojana_sahayak

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
SECRET_KEY=change-me-to-a-long-random-secret-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@ChangeMe123
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000

# Scraper
CRAWLER_USER_AGENT=YojanaSahayakBot/1.0 (+https://localhost; research; respectful crawler)
CRAWL_DELAY_SECONDS=1.5
DEFAULT_CRAWL_FREQUENCY_MINUTES=15
MAX_PARTNER_RADIUS_KM=100
PARTNER_RADIUS_STEPS_KM=20,40,60,100

# Ranking weights (must sum to ~100)
WEIGHT_ELIGIBILITY=40
WEIGHT_PURPOSE=25
WEIGHT_LOAN_AMOUNT=15
WEIGHT_PROJECT_COST=10
WEIGHT_OTHER=10

# Freshness thresholds (days)
FRESHNESS_FRESH_DAYS=7
FRESHNESS_AGING_DAYS=30

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_INTERNAL_URL=http://backend:8000

# Optional local ML (leave empty to use rule-based NLP only)
ENABLE_EMBEDDINGS=false
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
